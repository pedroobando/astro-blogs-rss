---
// import { Formatter } from '@/utils/formatter';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  author: CollectionEntry<'author'>;
}
const { author } = Astro.props;
const theAuthor = author.data;
---

<div class="max-w-lg mx-auto bg-white rounded-lg shadow-md p-5">
  <Image class="w-32 h-32 rounded-full mx-auto" src={theAuthor.avatar} alt={theAuthor.name} />
  <h2 class="text-center text-2xl font-semibold mt-3 text-slate-700 hover:text-slate-900 transition-all">
    {theAuthor.name}
  </h2>
  <p class="text-center text-slate-600 mt-1">
    {theAuthor.subtitle}
  </p>
  <div class="flex justify-center mt-5">
    <a href={`https://x.com/${theAuthor.twitter}`} class="text-blue-500 hover:text-blue-700 mx-3">Twitter</a>
    <a href={theAuthor.linkedIn} class="text-blue-500 hover:text-blue-700 mx-3">LinkedIn</a>
    <a href={theAuthor.github} class="text-blue-500 hover:text-blue-700 mx-3">GitHub</a>
  </div>
  <div class="mt-5">
    <h3 class="text-xl font-semibold">Bio</h3>
    <p class="text-gray-600 mt-2">
      {theAuthor.bio}
    </p>
  </div>
  <footer class="flex flex-row justify-end mt-2">
    <a href={`/blog/${author.id}`} class="text-slate-700 hover:animate-pulse hover:text-fuchsia-800">Ver mas</a>
  </footer>
</div>
