---
import { Formatter } from '@/utils/formatter';
const { frontmatter, url } = Astro.props;
// console.log(frontmatter.date);
---

<div class="lg:flex">
  <img class="object-cover w-full h-56 rounded-lg lg:w-64" src={frontmatter.image} alt={frontmatter.title} />

  <div class="flex flex-col justify-between py-6 lg:mx-6">
    <a href={url} class="text-lg font-semibold">
      {frontmatter.description}
    </a>

    <span class="text-sm text-slate-300">On: {Formatter(frontmatter.date)}</span>
  </div>
</div>
