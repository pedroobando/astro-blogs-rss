---
import type { GetStaticPaths } from 'astro';
import BlogLayout from '@/layouts/BlogLayout.astro';
import { getCollection, render, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { Formatter } from '@/utils/formatter';

export const getStaticPaths = (async () => {
  const blogPosts = await getCollection('blog');

  return blogPosts.map((post) => {
    return {
      params: { slug: post.id },
      props: { post: post },
    };
  });
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { slug } = Astro.params;

// console.log(post);
const frontMatter = post.data;

// Resolvemos la referencia al autor para obtener sus datos
const author = (await getEntry('author', frontMatter.author.id))?.data;
// console.log(frontMatter.author.id);

const { Content, headings } = await render(post);
---

<BlogLayout title={frontMatter.title}>
  <h1 class="text-xs text-slate-500 mb-0">{frontMatter.title}</h1>
  <!-- <h3 id="autorName" class="text-sm text-slate-600 mb-0">{frontMatter.author}</h3> -->
  <div class="text-base text-slate-300 mb-0 flex flex-row gap-x-3">
    {author && <Image src={author?.avatar} alt={author?.name} class="rounded-full" width={50} height={50} />}

    <div class="flex flex-col">
      <a
        href={`/blog/${frontMatter.author.id}`}
        class="hover:underline text-blue-600 hover:text-blue-500 transition-colors">{author?.name}</a
      >
      <span class="text-xs text-gray-400">{Formatter(frontMatter.date)}</span>
    </div>
  </div>

  <Image
    src={frontMatter.image}
    alt={frontMatter.title}
    width={600}
    height={220}
    class="object-cover w-full h-62.5 my-5 rounded-md"
  />

  <h3>Tabla de contenido</h3>
  <ol>
    {
      headings.map((heading, index) => (
        <li>
          <a href={`#${heading.slug}`}>
            {index + 1} - {heading.text}
          </a>
        </li>
      ))
    }
  </ol>

  <div class="mt-4">
    <Content />
  </div>

  <footer class="my-10">
    <a href="#btn-back">Ir arriba</a>
  </footer>
</BlogLayout>
